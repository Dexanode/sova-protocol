{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sova.network/schemas/pilot-feedback-v1.json",
  "title": "SOVA bounded external pilot feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sessionId",
    "submittedAt",
    "role",
    "taskResults",
    "clarityRating",
    "trustRating",
    "incidentObserved",
    "rejectionReasonUnderstood"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "role": { "enum": ["issuer", "consumer", "subject", "observer"] },
    "taskResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "completed", "seconds"],
        "properties": {
          "task": {
            "enum": [
              "inspect_attestation",
              "evaluate_policy",
              "explain_rejection",
              "verify_disclosure"
            ]
          },
          "completed": { "type": "boolean" },
          "seconds": { "type": "integer", "minimum": 0, "maximum": 7200 }
        }
      }
    },
    "clarityRating": { "type": "integer", "minimum": 1, "maximum": 5 },
    "trustRating": { "type": "integer", "minimum": 1, "maximum": 5 },
    "incidentObserved": { "type": "boolean" },
    "rejectionReasonUnderstood": { "type": "boolean" },
    "comments": { "type": "string", "maxLength": 2000 }
  }
}
