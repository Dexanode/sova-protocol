{
  "name": "sova-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SOVA — verifiable reputation for onchain finance",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "lint:sol": "solhint contracts/**/*.sol",
    "test:solidity": "hardhat test solidity",
    "clean": "hardhat clean",
    "preflight:whitechain": "hardhat run scripts/preflight.ts --network whitechainSepolia",
    "prepare:schema-activation": "tsx scripts/prepare-schema-activation.ts",
    "verify:whitechain": "tsx scripts/verify-explorer.ts",
    "schema:status": "tsx scripts/schema-status.ts",
    "schema:propose": "hardhat run scripts/schema-propose.ts --network whitechainSigner1",
    "schema:approve": "hardhat run scripts/schema-approve.ts --network whitechainSigner2",
    "schema:execute": "hardhat run scripts/schema-execute.ts --network whitechainSigner1",
    "issuer:status": "tsx scripts/issuer-status.ts",
    "issuer:propose": "hardhat run scripts/issuer-propose.ts --network whitechainSigner1",
    "issuer:approve": "hardhat run scripts/issuer-approve.ts --network whitechainSigner2",
    "issuer:execute": "hardhat run scripts/issuer-execute.ts --network whitechainSigner1",
    "pilot:issue": "hardhat run scripts/pilot-issue.ts --network whitechainIssuer",
    "pilot:status": "tsx scripts/pilot-status.ts",
    "pilot:revoke": "hardhat run scripts/pilot-revoke.ts --network whitechainIssuer",
    "indexer:sync": "tsx scripts/indexer-sync.ts",
    "api:start": "tsx scripts/api-server.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "relay:prepare": "tsx scripts/relay-prepare.ts",
    "issuer:sign-relay": "hardhat run scripts/issuer-sign-relay.ts --network whitechainIssuer",
    "relay:submit": "hardhat run scripts/relay-submit.ts --network whitechainSepolia",
    "relay:status": "tsx scripts/relay-status.ts",
    "deploy:local": "hardhat run scripts/deploy-network-proof.ts --build-profile production",
    "deploy:registry:local": "hardhat run scripts/deploy-registry.ts --build-profile production",
    "deploy:whitechain": "hardhat run scripts/deploy-network-proof.ts --build-profile production --network whitechainSepolia",
    "deploy:registry:whitechain": "hardhat run scripts/deploy-registry.ts --build-profile production --network whitechainSepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-keystore": "3.0.13",
    "@nomicfoundation/hardhat-mocha": "3.1.0",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@types/mocha": "10.0.10",
    "@types/node": "^24.0.0",
    "chai": "6.2.2",
    "ethers": "6.17.0",
    "hardhat": "3.13.0",
    "mocha": "11.8.0",
    "solhint": "6.2.4",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
